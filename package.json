{
  "name": "synapse",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:boundaries": "eslint . --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "directory-map": "node scripts/generate-directory-map.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs",
    "emoji-data": "node scripts/copy-emoji-data.mjs",
    "web:dev": "yarn emoji-data && turbo run dev --filter=web",
    "web:dev:local": "yarn emoji-data && node scripts/print-local-urls.mjs 3000 && turbo run dev:local --filter=web",
    "web:build": "yarn emoji-data && turbo run build --filter=web",
    "web:start": "turbo run start --filter=web",
    "web:lint": "turbo run lint --filter=web",
    "web:typecheck": "turbo run check-types --filter=web",
    "ui:lint": "turbo run lint --filter=@syn/ui",
    "ui:typecheck": "turbo run check-types --filter=@syn/ui",
    "ui:storybook": "turbo run storybook --filter=@syn/ui",
    "ui:build-storybook": "turbo run build-storybook --filter=@syn/ui",
    "db:generate": "turbo run db:generate --filter=@syn/db",
    "db:migrate": "turbo run db:migrate --filter=@syn/db",
    "db:push": "turbo run db:push --filter=@syn/db",
    "db:setup": "turbo run db:setup --filter=@syn/db",
    "db:reset": "turbo run db:reset --filter=@syn/db",
    "db:reset-user": "turbo run db:reset-user --filter=@syn/db",
    "db:seed": "turbo run db:seed --filter=@syn/db",
    "db:seed-users": "turbo run db:seed-users --filter=@syn/db",
    "db:schema-reference": "turbo run db:schema-reference --filter=@syn/db",
    "contract:init": "node tooling/contract.ts init",
    "contract:run": "node tooling/contract.ts run",
    "contract:record": "node tooling/contract.ts record",
    "contract:add": "node tooling/contract.ts add",
    "contract:qa": "node tooling/contract.ts qa",
    "contract:built": "node tooling/contract.ts built",
    "review:run": "node tooling/review-run.ts",
    "status": "node tooling/status.ts",
    "spec:init": "node tooling/spec-init.ts",
    "specs:archive": "node tooling/specs-archive.ts",
    "truth:promote": "node tooling/truth-promote.ts",
    "check-settings": "node tooling/check-settings.ts",
    "check-reviewers": "node tooling/check-reviewers.ts",
    "check-specs": "node tooling/check-specs.ts",
    "check-refs": "node tooling/check-refs.ts",
    "check-test-weakening": "node tooling/check-test-weakening.ts",
    "test:hooks": "node tooling/test-hooks.ts",
    "budget": "node tooling/budget.ts",
    "gen:agents": "node tooling/gen-agents.ts",
    "doctor": "node tooling/doctor.ts",
    "hooks:install": "node tooling/hooks-install.ts",
    "lint:docs": "node tooling/lint-frontmatter.ts",
    "verify:fast": "node tooling/verify-fast.ts",
    "check-types:tooling": "tsc -p tooling",
    "cost": "node tooling/cost.ts",
    "test:tooling": "node --test \"tooling/**/*.test.ts\""
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
    "@syn/config": "workspace:*",
    "@types/node": "^22",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "emojibase-data": "^17.0.0",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "turbo": "^2.9.12",
    "typescript": "5.9.2",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
