{
  "expect": "fail",
  "tier": "overlay",
  "message": "permissions.ask is missing Bash(*db:push*)",
  "settings": {
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
      "deny": [
        "Bash(git reset --hard *)",
        "Bash(git clean *)",
        "Bash(git branch -D *)",
        "Bash(git filter-branch *)",
        "Bash(npm publish *)",
        "Bash(npm login *)",
        "Read(**/.env.*)",
        "Read(**/.env)",
        "Read(**/secrets/**)",
        "Read(**/*.pem)",
        "Read(~/.ssh/**)",
        "Read(~/.aws/**)",
        "Bash(*db:reset*)",
        "Bash(*db:drop*)",
        "Bash(*drizzle-kit drop*)",
        "Bash(*supabase db reset*)",
        "Bash(*DROP SCHEMA*)",
        "Bash(*DROP DATABASE*)"
      ],
      "ask": [
        "Bash(*db:migrate*)",
        "Bash(*db:seed*)",
        "Bash(*db:setup*)",
        "Bash(*db:local:reset*)",
        "Bash(*drizzle-kit migrate*)",
        "Bash(*drizzle-kit push*)",
        "Bash(*supabase db push*)"
      ]
    },
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Edit|Write|NotebookEdit",
          "hooks": [
            {
              "type": "command",
              "command": "node \"${CLAUDE_PROJECT_DIR}/tooling/hooks/results-gate.ts\"",
              "timeout": 10
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node \"${CLAUDE_PROJECT_DIR}/tooling/hooks/session-start.ts\"",
              "timeout": 10
            }
          ]
        }
      ]
    }
  }
}
