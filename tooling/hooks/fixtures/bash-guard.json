    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "grep for the phrase",
      "command": "grep -rn 'drop schema' packages/db"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "root migrate script",
      "command": "yarn db:migrate",
      "message": "D-STK-18"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "workspace setup script",
      "command": "yarn workspace @pem/db db:setup"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "seed users",
      "command": "yarn db:seed-users"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "the local reset asks",
      "command": "yarn db:local:reset"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "push script",
      "command": "yarn db:push"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "raw drizzle-kit push",
      "command": "yarn drizzle-kit push"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "raw drizzle-kit migrate in the workspace",
      "command": "yarn workspace @pem/db drizzle-kit migrate"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "supabase db push",
      "command": "supabase db push"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "supabase migration up",
      "command": "supabase migration up"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "migrate script by path",
      "command": "node packages/db/scripts/migrate.ts"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "local setup script asks",
      "command": "yarn db:setup:local"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "local setup script by path",
      "command": "node packages/db/scripts/setup-local.ts"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "reset script by path after cd",
      "command": "cd packages/db && node --env-file-if-exists=.env.local scripts/reset-local-db.ts"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "chained after the local start",
      "command": "yarn db:local && yarn db:migrate && yarn db:setup"
    },
    {
      "rule": "db-change",
      "expect": "ask",
      "name": "behind env",
      "command": "env DATABASE_ENVIRONMENT=staging yarn db:migrate"
    },
    {
      "rule": "db-change",
      "expect": "allow",
      "name": "integration tests",
      "command": "yarn test:db"
    },
    {
      "rule": "db-change",
      "expect": "allow",
      "name": "migration check",
      "command": "yarn check-migrations"
    },
    {
      "rule": "db-change",
      "expect": "allow",
      "name": "reading the migrate script",
      "command": "cat packages/db/scripts/migrate.ts"
    },
    {
      "rule": "db-change",
      "expect": "allow",
      "name": "generate",
      "command": "yarn workspace @pem/db db:generate"
    }
  ]
}
