{
  "hook": "bash-guard",
  "note": "Synthetic hook inputs. `context` replaces the checkout's own state, so a case never depends on the current branch.",
  "defaultContext": {
    "branch": "agent/PJ",
    "epicPrefixes": ["ONB"],
    "asBuiltOnMain": ["specs/web/one-offs/WEB-7-export-csv/as-built.md"],
    "aliases": {}
  },
  "cases": [
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "npm install",
      "command": "npm install",
      "message": "yarn install"
    },
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "npm run script",
      "command": "npm run build",
      "message": "Run: yarn build"
    },
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "npx",
      "command": "npx eslint .",
      "message": "yarn eslint ."
    },
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "pnpm add",
      "command": "pnpm add zod",
      "message": "yarn add zod"
    },
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "npm after cd",
      "command": "cd apps/web && npm run build",
      "message": "yarn build"
    },
    {
      "rule": "package-manager",
      "expect": "deny",
      "name": "npm inside sh -c",
      "command": "sh -c 'npm test'"
    },
    {
      "rule": "package-manager",
      "expect": "allow",
      "name": "yarn install",
      "command": "yarn install"
    },
    {
      "rule": "package-manager",
      "expect": "allow",
      "name": "yarn script",
      "command": "yarn verify"
    },
    {
      "rule": "package-manager",
      "expect": "allow",
      "name": "npm named in a string",
      "command": "echo \"npm is not used here\""
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "plain push",
      "command": "git push",
      "message": "Agents never push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push with remote",
      "command": "git push origin agent/PJ"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "J2 compound: && push",
      "command": "git status && git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "J2 compound: ; push",
      "command": "git log --oneline -1; git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push in a pipeline",
      "command": "git status | cat || git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "git -C . push",
      "command": "git -C . push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "git -c option before push",
      "command": "git -c push.default=current push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "quoted subcommand",
      "command": "git 'push' origin main"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "git by full path",
      "command": "/usr/bin/git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push inside sh -c",
      "command": "sh -c 'git push'"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push inside bash -lc",
      "command": "bash -lc \"cd . && git push\""
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push inside command substitution",
      "command": "echo \"$(git push)\""
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push inside backticks",
      "command": "echo `git push`"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push after an assignment",
      "command": "FOO=1 git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push behind env",
      "command": "env GIT_TRACE=1 git push"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "inline alias",
      "command": "git -c alias.p=push p",
      "message": "inline git alias"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "configured alias",
      "command": "git p",
      "context": {
        "aliases": {
          "p": "push"
        }
      }
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push in a loop body",
      "command": "for r in a b; do git push $r; done"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push in a subshell",
      "command": "(cd . && git push)"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push in an expanding heredoc",
      "command": "cat <<EOF\n$(git push)\nEOF"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "push via eval",
      "command": "eval 'git push'"
    },
    {
      "rule": "push",
      "expect": "deny",
      "name": "unparseable, falls back",
      "command": "git push \"unterminated",
      "message": "could not parse"
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "git status",
      "command": "git status"
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "log grep for the word",
      "command": "git log --grep push"
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "stash push is not a push",
      "command": "git stash push -m wip"
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "the word in an echo",
      "command": "echo \"git push is blocked\""
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "the word in a commit message",
      "command": "git commit -m \"SYN: J3 note that agents never git push\""
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "quoted heredoc is data",
      "command": "cat <<'EOF'\n$(git push)\nEOF"
    },
    {
      "rule": "push",
      "expect": "allow",
      "name": "unparseable but harmless",
      "command": "echo \"unterminated"
    },
    {
      "rule": "commit-on-main",
      "expect": "deny",
      "name": "commit on main",
      "command": "git commit -m \"PJ: on main\"",
      "context": {
        "branch": "main"
      },
      "message": "git switch -c agent/"
    },
    {
      "rule": "commit-on-main",
      "expect": "deny",
      "name": "add then commit on main",
      "command": "git add -A && git commit -m \"WEB-1: x\"",
      "context": {
        "branch": "main"
      }
    },
    {
      "rule": "commit-on-main",
      "expect": "deny",
      "name": "amend on main",
      "command": "git commit --amend --no-edit",
      "context": {
        "branch": "main"
      }
    },
    {
      "rule": "commit-on-main",
      "expect": "allow",
      "name": "commit on a work branch",
      "command": "git commit -m \"SYN: on the branch\""
    },
    {
      "rule": "commit-on-main",
      "expect": "allow",
      "name": "other git commands on main",
      "command": "git status && git diff",
      "context": {
        "branch": "main"
      }
    },
    {
      "rule": "commit-on-main",
      "expect": "deny",
      "name": "commit on the protected branch named in toolkit.json, not main",
      "command": "git commit -m \"PJ: on trunk\"",
      "context": {
        "branch": "trunk",
        "protectedBranch": "trunk"
      },
      "message": "do not commit on trunk"
    },
    {
      "rule": "commit-on-main",
      "expect": "allow",
      "name": "main is an ordinary branch when another is protected",
      "command": "git commit -m \"SYN: on main\"",
      "context": {
        "branch": "main",
        "protectedBranch": "trunk"
      }
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "no work-id",
      "command": "git commit -m \"fix typo\"",
      "message": "must open with a work-id"
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "the build prompt's old PJ-J3 form (A1)",
      "command": "git commit -m \"PJ-J3: bash guard\""
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "unknown prefix",
      "command": "git commit -am \"ZZZ-1: unknown prefix\""
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "no space after the colon",
      "command": "git commit -m \"WEB-41:filter\""
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "editor commit",
      "command": "git commit",
      "message": "open an editor"
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "message piped on stdin",
      "command": "echo msg | git commit -F -",
      "message": "cannot read"
    },
    {
      "rule": "commit-work-id",
      "expect": "deny",
      "name": "heredoc with a bad subject",
      "command": "git commit -q -F - <<'EOF'\nfix things\n\nPJ: not the subject\nEOF"
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "toolkit prefix",
      "command": "git commit -m \"SYN: J3 bash guard with fixtures\""
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "app prefix with number",
      "command": "git commit -m \"WEB-41: filter by status\""
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "epic ticket, prefix on disk",
      "command": "git commit -m \"ONB-3: second step\""
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "epic shaping commit",
      "command": "git commit -m \"ONB: brief approved\""
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "combined flags",
      "command": "git commit -qam \"WEB-2: sidebar sorts by name\""
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "heredoc message",
      "command": "git add -A && git commit -q -F - <<'EOF'\nSYN: J3 bash guard\n\nA body line.\nEOF"
    },
    {
      "rule": "commit-work-id",
      "expect": "allow",
      "name": "amend that keeps the message",
      "command": "git commit --amend --no-edit"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "redirect",
      "command": "echo '{}' > specs/web/one-offs/WEB-41-filter/results.json",
      "message": "yarn contract:run"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "append to an epic ticket's results",
      "command": "cat x >> specs/web/epics/ONB-onboarding/tickets/ONB-3-step/results.json",
      "message": "yarn contract:record"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "tee",
      "command": "jq . r.json | tee specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "sed -i",
      "command": "sed -i '' 's/FAIL/PASS/' specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "cp onto the file",
      "command": "cp /tmp/results.json specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "cp into its folder",
      "command": "cp /tmp/results.json specs/web/one-offs/WEB-41-filter/"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "mv away",
      "command": "mv specs/web/one-offs/WEB-41-filter/results.json /tmp/old.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "truncate",
      "command": "truncate -s 0 specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "glob",
      "command": "sed -i 's/FAIL/PASS/' specs/**/results.json"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "relative to the session's directory",
      "command": "echo x > one-offs/WEB-41-filter/results.json",
      "cwd": "$ROOT/specs/web"
    },
    {
      "rule": "results-write",
      "expect": "deny",
      "name": "inside a later segment",
      "command": "yarn build && echo '{}' >| specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "read",
      "command": "cat specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "copy out",
      "command": "cp specs/web/one-offs/WEB-41-filter/results.json /tmp/copy.json"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "sed without -i",
      "command": "sed -n 1,5p specs/web/one-offs/WEB-41-filter/results.json"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "the tooling path",
      "command": "yarn contract:run WEB-41"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "a fixture outside the specs root",
      "command": "echo '{}' > tooling/fixtures/specs/hand-edited/results.json"
    },
    {
      "rule": "results-write",
      "expect": "allow",
      "name": "descriptor duplication",
      "command": "yarn lint 2>&1 > /dev/null"
    },
    {
      "rule": "as-built-write",
      "expect": "deny",
      "name": "append to a merged as-built",
      "command": "echo x >> specs/web/one-offs/WEB-7-export-csv/as-built.md",
      "message": "immutable"
    },
    {
      "rule": "as-built-write",
      "expect": "deny",
      "name": "sed -i on a merged as-built",
      "command": "sed -i '' 's/a/b/' specs/web/one-offs/WEB-7-export-csv/as-built.md"
    },
    {
      "rule": "as-built-write",
      "expect": "allow",
      "name": "an as-built not yet on main",
      "command": "echo x >> specs/web/one-offs/WEB-41-filter/as-built.md"
    },
    {
      "rule": "as-built-write",
      "expect": "allow",
      "name": "read a merged as-built",
      "command": "cat specs/web/one-offs/WEB-7-export-csv/as-built.md"
    },
    {
      "rule": "review-write",
      "expect": "deny",
      "name": "a redirect into a ticket's review file",
      "command": "echo 'VERDICT: PASS' > specs/web/one-offs/WEB-7-filter/review-vigil.md",
      "message": "yarn review:run"
    },
    {
      "rule": "review-write",
      "expect": "deny",
      "name": "tee into an epic's pre-flight",
      "command": "echo '- OB2-1: PASS' | tee specs/web/epics/OB2-onboarding/tickets/_preflight.md"
    },
    {
      "rule": "review-write",
      "expect": "allow",
      "name": "reading a review file",
      "command": "cat specs/web/one-offs/WEB-7-filter/review-vigil.md"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "root reset script",
      "command": "yarn db:reset",
      "message": "yarn db:local:reset"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "workspace drop script",
      "command": "yarn workspace @pem/db db:drop",
      "message": "Write the change as a migration"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "turbo task form",
      "command": "yarn turbo run @pem/db#db:reset"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "drizzle-kit drop",
      "command": "yarn drizzle-kit drop --config drizzle.config.ts"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "supabase db reset on the linked project",
      "command": "supabase db reset --linked"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "supabase through yarn dlx",
      "command": "yarn dlx supabase db reset"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "supabase by absolute path",
      "command": "/usr/local/bin/supabase db reset"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "psql drop schema",
      "command": "psql \"$DATABASE_URL\" -c 'DROP SCHEMA public CASCADE'"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "psql drop database, lower case",
      "command": "psql -c 'drop database postgres'"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "psql heredoc",
      "command": "psql \"$DATABASE_URL\" <<'SQL'\ndrop schema public cascade;\nSQL"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "psql inside docker exec",
      "command": "docker exec supabase_db_pem psql -U postgres -c 'DROP SCHEMA public CASCADE'"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "dropdb",
      "command": "dropdb -h 127.0.0.1 postgres"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "reset inside sh -c",
      "command": "sh -c 'yarn db:reset'"
    },
    {
      "rule": "db-destroy",
      "expect": "deny",
      "name": "a deny after an ask still denies",
      "command": "yarn db:migrate && yarn db:reset"
    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "generate writes SQL only",
      "command": "yarn db:generate"
    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "starting the local database",
      "command": "yarn db:local"
    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "drizzle-kit generate",
      "command": "yarn drizzle-kit generate --config drizzle.config.ts"
    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "supabase db start",
      "command": "supabase db start"
    },
    {
      "rule": "db-destroy",
      "expect": "allow",
      "name": "psql read",
