{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack enable && cd ../.. && yarn install --immutable",
  "buildCommand": "cd ../.. && yarn web:build",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/jobs/scheduler",
      "schedule": "*/5 * * * *"
    }
  ]
}
