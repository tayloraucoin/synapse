# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js
package-lock.json
.yarn/install-state.gz

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
storybook-static
*.tsbuildinfo

# Emojibase data staged from a pinned devDependency by a script.
# Generated, never hand-edited, never committed.
apps/web/public/emoji/

# Yarn (Berry — keep patches/plugins/releases tracked)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Cursor (local-only; shared agent guidance lives in AGENTS.md)
.cursor/

# Claude Code (local-only; CLAUDE.md pointers are tracked)
# (`.claude/*` rather than `.claude/` so the negation below can take effect —
# git cannot re-include a file whose parent directory is itself excluded.)
.claude/*
# Exception: shared permission/sandbox rules are tracked so every worktree
# inherits them on checkout. Machine-local churn stays in settings.local.json.
!.claude/settings.json
# The practice's path rules, house skills and generated subagents are tracked
# too (record 0001); settings.local.json stays ignored under .claude/*.
!.claude/rules/
!.claude/skills/
!.claude/agents/
CLAUDE.local.md

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem

# Proof logs written by yarn contract:run; recorded evidence is .md or .txt
specs/**/evidence/.*.tmp
specs/**/evidence/*.log
