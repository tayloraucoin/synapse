{
  "name": "@syn/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./providers/theme-provider": {
      "types": "./src/providers/theme-provider.tsx",
      "default": "./src/providers/theme-provider.tsx"
    },
    "./hooks/use-theme": {
      "types": "./src/hooks/use-theme.ts",
      "default": "./src/hooks/use-theme.ts"
    },
    "./hooks/use-prefers-reduced-motion": {
      "types": "./src/hooks/use-prefers-reduced-motion.ts",
      "default": "./src/hooks/use-prefers-reduced-motion.ts"
    },
    "./cn": {
      "types": "./src/lib/cn.ts",
      "default": "./src/lib/cn.ts"
    },
    "./text": {
      "types": "./src/primitives/typography/text/index.ts",
      "default": "./src/primitives/typography/text/index.ts"
    },
    "./theme-control": {
      "types": "./src/composed/control/theme-control/index.ts",
      "default": "./src/composed/control/theme-control/index.ts"
    },
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@syn/constants": "*",
    "@syn/types": "*",
    "@syn/utils": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-themes": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@syn/config": "*",
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "storybook": "^8.6.14",
    "tailwindcss": "^4.1.11",
    "typescript": "5.9.2",
    "vite": "^6.3.5"
  }
}
