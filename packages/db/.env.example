# packages/db/.env — the tier this shell talks to, and the six URLs it can use.
#
# DATABASE_ENVIRONMENT selects the tier. It DEFAULTS TO `local` when unset:
# a shell with nothing configured must not be able to reach production.
#
# Runtime queries use the TRANSACTION pooler (:6543) with prepare:false.
# Migrations and drizzle-kit use the SESSION pooler (:5432). Despite the
# historical name, the session URL is NOT Supabase's "Direct connection" tab,
# which is IPv6-only.
#
# NEVER run db:migrate, db:push, db:seed, or db:reset from an agent session.
# The agent authors SQL and stops; a human applies it.

DATABASE_ENVIRONMENT=local

# --- local Postgres ---
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOCAL_DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- staging Supabase ---
SUPABASE_STAGING_TRANSACTION_POOLER_CONNECTION_URL=
SUPABASE_STAGING_SESSION_POOLER_CONNECTION_URL=

# --- production Supabase ---
SUPABASE_LIVE_TRANSACTION_POOLER_CONNECTION_URL=
SUPABASE_LIVE_SESSION_POOLER_CONNECTION_URL=

# --- Supabase Auth, for db:seed-users only ---
# Local development uses STAGING auth with a LOCAL public schema (SETUP.md §3),
# so these point at staging even when DATABASE_ENVIRONMENT=local.
NEXT_PUBLIC_SUPABASE_URL_STAGING=
SUPABASE_SERVICE_ROLE_KEY_STAGING=
