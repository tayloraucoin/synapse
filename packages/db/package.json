{
  "name": "@syn/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./connection-env": "./src/connection-env.ts",
    "./build-database-env-for-next-config": "./src/build-database-env-for-next-config.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:setup": "node --experimental-strip-types --no-warnings scripts/run-setup-sql.ts",
    "db:reset": "node --experimental-strip-types --no-warnings scripts/reset-local-db.ts",
    "db:seed": "tsx src/seed/index.ts",
    "db:seed-users": "tsx scripts/seed-users.ts",
    "db:schema-reference": "node scripts/generate-schema-reference.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "@syn/constants": "*",
    "@syn/types": "*",
    "@syn/utils": "*",
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@syn/config": "*",
    "@types/node": "^22.7.5",
    "dotenv": "^16.4.7",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.39.1",
    "tsx": "^4",
    "typescript": "5.9.2"
  }
}
