# Synapse — the environment surface, one line per variable `apps/web/env.ts` declares.
#
# WHERE THINGS LIVE
#   apps/web/.env.local  — the app's runtime subset (this file's variables)
#   packages/db/.env     — the drizzle-kit URLs only (see packages/db/.env.example)
#
# TIERS. `DATABASE_ENVIRONMENT` selects one, and DEFAULTS TO `local` when unset:
# a shell with nothing configured must not be able to reach production.
#
#   local       local Postgres for public.*  +  STAGING Supabase Auth
#   staging     staging Supabase             +  staging Supabase Auth
#   production  production Supabase          +  production Supabase Auth
#
# `local` can instead use the Supabase stack on this machine: set the three
# _LOCAL variables below and run `yarn db:local:up` (SETUP.md §3, Option D).
#
# `local` and `staging` share the staging auth project on purpose — a foreign
# key cannot span two databases, so the database holding your public.* tables
# must also hold the auth.users you sign in against. See packages/db/SETUP.md §3.

DATABASE_ENVIRONMENT=local

# NODE_ENV is declared in apps/web/env.ts but is set by the tooling, never by
# hand: `next dev` sets development, `next build` sets production. Setting it
# here would fight them.
# NODE_ENV=

# ---------------------------------------------------------------- Postgres --
# Runtime uses the TRANSACTION pooler (:6543) with prepare:false.
# Migrations use the SESSION pooler (:5432).
LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
LOCAL_DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres
SUPABASE_STAGING_TRANSACTION_POOLER_CONNECTION_URL=
SUPABASE_STAGING_SESSION_POOLER_CONNECTION_URL=
SUPABASE_LIVE_TRANSACTION_POOLER_CONNECTION_URL=
SUPABASE_LIVE_SESSION_POOLER_CONNECTION_URL=

# ------------------------------------------------------- Supabase (public) --
# Both key names are accepted; Supabase's newer "publishable" name and the
# legacy "anon" name coexist, and `firstNonEmpty` takes whichever is set.
NEXT_PUBLIC_SUPABASE_URL_STAGING=
NEXT_PUBLIC_SUPABASE_ANON_KEY_STAGING=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_STAGING=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The local Supabase stack (WEB-2). Setting the URL opts the local tier in;
# unset, local signs in against staging as above. It must be localhost or
# 127.0.0.1. Copy the values from `yarn db:local:status` (API URL, Publishable key).
NEXT_PUBLIC_SUPABASE_URL_LOCAL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY_LOCAL=
NEXT_PUBLIC_SUPABASE_ANON_KEY_LOCAL=

# Unset = a host-only auth cookie, which is correct for a single origin.
NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=

# ------------------------------------------- Supabase (server-only secrets) --
# NEVER prefixed NEXT_PUBLIC_. These must not reach a browser bundle.
SUPABASE_SERVICE_ROLE_KEY_STAGING=
SUPABASE_SECRET_KEY_STAGING=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# The local stack's secret key, from `yarn db:local:status` (Secret key).
SUPABASE_SECRET_KEY_LOCAL=
SUPABASE_SERVICE_ROLE_KEY_LOCAL=

# ------------------------------------------------------------- app origins --
# The LOCAL value is ignored: the local origin is always http://localhost:3000,
# so a stale staging URL here cannot send an OAuth redirect or an email
# confirmation link to the deployed app.
NEXT_PUBLIC_SITE_URL_LOCAL=http://localhost:3000
NEXT_PUBLIC_SITE_URL_STAGING=
NEXT_PUBLIC_SITE_URL=

# ------------------------------------------------------------- Web Push -----
# Generate a pair once, and use the SAME pair for every tier:
#
#   npx web-push generate-vapid-keys
#
# Changing the public key invalidates every existing subscription silently —
# devices keep their old key, the push service rejects the send, and nobody is
# told. Treat the pair as permanent.
#
# VAPID_SUBJECT is a mailto: the push service can contact about a misbehaving
# sender. It falls back to VAPID_MAILTO_SUBJECT in @syn/constants, which is
# empty until CONTACT_EMAIL is filled in — the first push cannot be sent
# without one of the two.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ------------------------------------------------------------- scheduler ----
# The bearer secret the notification cron route requires. Minimum 16 chars.
# Unset = the route answers 503 and nothing is ever sent, which is the safe
# failure for a scheduler.
CRON_SECRET=

# ------------------------------------------------------------ Google OAuth --
# Configured in the Supabase dashboard, not by this app. Declared so the names
# are discoverable from one place and a deploy that sets them is not a surprise.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------- integrations ---
# USE-100. Read only through packages/api/src/env.ts; never NEXT_PUBLIC_.
#
# INTEGRATION_TOKEN_KEY encrypts every stored Linear and Google token
# (AES-256-GCM): 32 random bytes, base64 (`openssl rand -base64 32`). Set it
# in Vercel per tier. Changing it makes every stored token unreadable, so
# each connection must be made again: treat it as permanent.
#
# LINEAR_CLIENT_ID is the Linear OAuth application's client id (a public
# app; PKCE, so no client secret). Its redirect URI is
# <site>/api/integrations/linear/callback.
INTEGRATION_TOKEN_KEY=
LINEAR_CLIENT_ID=
#
# GOOGLE_CALENDAR_CLIENT_ID / _SECRET are Google Calendar's own Web
# application OAuth client (USE-103), in its own Google Cloud project, never
# the sign-in's above. Read-only: calendar.calendarlist.readonly and
# calendar.events.readonly. Publishing status must be "In production" (in
# Testing, refresh tokens die after seven days). Its redirect URI is
# <site>/api/integrations/google/callback.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ------------------------------------------------------------------ undo ---
# USE-92. Read only through packages/api/src/env.ts; never NEXT_PUBLIC_.
#
# UNDO_TOKEN_KEY signs every planner write's Undo token (HMAC-SHA256), so a
# client cannot forge one: 32 random bytes, base64 (`openssl rand -base64 32`).
# Set it in Vercel per tier. Changing it only refuses the Undo of writes made
# before the change.
UNDO_TOKEN_KEY=

# --------------------------------------------------------------------- CI ---
# Lets a build without secrets pass env validation.
SKIP_ENV_VALIDATION=
